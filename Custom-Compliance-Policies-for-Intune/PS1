$csInstalled = (
    (Test-Path "C:\Program Files\CrowdStrike") -or
    (Get-Service -Name "CSFalconService","CSAgent" -ErrorAction SilentlyContinue)
)

$tlInstalled = Test-Path "C:\Program Files\ThreatLocker\threatlockerservice.exe"

$expressvpnInstall = Test-Path "C:\Program Files (x86)\ExpressVPN\expressvpn-ui\ExpressVPN.exe"

$results = @{
    CrowdStrikeInstalled  = [bool]$csInstalled
    ThreatLockerInstalled = [bool]$tlInstalled
    ExpressVPNInstalled = [bool]$expressvpnInstall
}

$results | ConvertTo-Json -Compress
